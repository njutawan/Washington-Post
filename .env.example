# NextAuth is the ONLY auth model. Do not configure Clerk or AUTH_URL separately.
# Generate a unique secret with: openssl rand -hex 48. Never commit the output.
NEXTAUTH_SECRET=
# Local development: http://localhost:3000. Production MUST be an HTTPS origin.
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Exactly one newsroom per deployment. Never take this from a request/client.
APP_TENANT_ID=local
# Production requires PostgreSQL with a NON-superuser runtime role and migrations.
# Include TLS certificate verification, e.g. sslmode=verify-full, for remote DBs.
DATABASE_URL=
# Local JSON development only; never accepted as a production fallback.
LOCAL_DATA_DIR=.local-data
# Public registration defaults OFF in production. All new accounts are readers.
ALLOW_SIGNUP=false
# Set ONLY if your ingress strips client input and overwrites this header.
# Without it all anonymous clients share a conservative bucket (no spoofable XFF).
TRUSTED_CLIENT_IP_HEADER=

# Operator-only environment (do NOT give these to the browser or web runtime).
# Backup owner must be a real named/on-call operator before launch.
BACKUP_OWNER=
# Proposed service objectives; approve and test on actual production-sized data.
BACKUP_RPO_MINUTES=15
BACKUP_RTO_MINUTES=60
BACKUP_DATABASE_URL=
RESTORE_DATABASE_URL=
BACKUP_DIR=
# openssl rand -hex 32; store in a separate secret manager from backup storage.
BACKUP_ENCRYPTION_KEY=
OPERATOR_ID=
# CONFIRM_EMPTY_RESTORE=yes is needed explicitly for a restore command.

# Helpers are disabled in production unless a unique 32+ character token is set.
# Calls must also include Origin equal to NEXTAUTH_URL.
LIVE_PUBLISH_TOKEN=
PUSH_SEND_TOKEN=
NEXT_PUBLIC_VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=

# Integrations: optional. No raw provider errors/PII are logged.
NEWS_API_KEY=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=washington-post-clone
# CI-only SENTRY_AUTH_TOKEN uploads maps; never expose it in NEXT_PUBLIC_*.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
# There is NO automatic newsletter sending; verified double-opt-in is not implemented.
RESEND_API_KEY=
CONTEXT7_API_KEY=
