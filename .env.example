# Get a free NewsAPI key at https://newsapi.org/
# If not set, the site will use curated local articles.
NEWS_API_KEY=

# --- Analytics (privacy-friendly, Plausible-compatible) ---
# Optional: if set, the client will also forward events to Plausible
# (in addition to the local /api/analytics/collect endpoint).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Error monitoring (Sentry) ---
# Get a DSN at https://sentry.io/. Leave blank to disable Sentry locally.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=washington-post-clone
# Auth token used by CI to upload source maps (SENTRY_AUTH_TOKEN env var)

# --- Auth (NextAuth) ---
# REQUIRED in production: secret used to sign JWT session tokens. Without it
# the app refuses to boot in production (see src/auth.ts).
NEXTAUTH_SECRET=
# Set to 1 to keep the no-credential "demo account" sign-in available in
# production (off by default there). Dev mode always has it.
NEXT_PUBLIC_ENABLE_DEMO=

# --- Dev/test endpoint tokens ---
# Shared secrets that unlock the dev-only helper endpoints in production
# (dev mode never needs them):
#   POST /api/live/publish  — x-live-publish-token:  $LIVE_PUBLISH_TOKEN
#   POST /api/push/send     — x-push-send-token:     $PUSH_SEND_TOKEN
# Leave unset in production to keep those endpoints disabled (HTTP 501).
LIVE_PUBLISH_TOKEN=
PUSH_SEND_TOKEN=

# --- Clerk ---
# Get these from https://dashboard.clerk.com/ -> API Keys.
# Without them the site still works using the legacy NextAuth demo sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/signin
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# --- CMS (Sanity) ---
# Create a project at https://www.sanity.io/manage and paste the keys here.
# Without these the site falls back to local in-repo demo content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Server-only read token for drafts / private datasets
SANITY_API_READ_TOKEN=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
